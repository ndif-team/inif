{
  "$defs": {
    "Metadata": {
      "properties": {
        "model": {
          "$ref": "#/$defs/ModelInfo"
        },
        "inif_version": {
          "default": "0.1",
          "title": "Inif Version",
          "type": "string"
        },
        "packages": {
          "additionalProperties": true,
          "title": "Packages",
          "type": "object"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "source_eval": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceEval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "total_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Time"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        }
      },
      "required": [
        "model"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "ModelInfo": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "huggingface_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Huggingface Id"
        },
        "generation_config": {
          "additionalProperties": true,
          "title": "Generation Config",
          "type": "object"
        },
        "loading_config": {
          "additionalProperties": true,
          "title": "Loading Config",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "Sample": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/TokenOrSeqRef"
          },
          "title": "Tokens",
          "type": "array"
        },
        "texts": {
          "items": {
            "$ref": "#/$defs/Text"
          },
          "title": "Texts",
          "type": "array"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/TokenAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/SampleScore"
          },
          "title": "Scores",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        },
        "interaction_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interaction Type"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "sample_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Hash"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "total_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Time"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        }
      },
      "required": [
        "id"
      ],
      "title": "Sample",
      "type": "object"
    },
    "SampleScore": {
      "properties": {
        "scorer": {
          "title": "Scorer",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "title": "Value"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "scorer",
        "value"
      ],
      "title": "SampleScore",
      "type": "object"
    },
    "Sequence": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "n_tokens": {
          "title": "N Tokens",
          "type": "integer"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/TokenOrSeqRef"
          },
          "title": "Tokens",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "id",
        "n_tokens",
        "tokens"
      ],
      "title": "Sequence",
      "type": "object"
    },
    "SourceEval": {
      "properties": {
        "framework": {
          "title": "Framework",
          "type": "string"
        },
        "framework_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framework Version"
        },
        "task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task"
        },
        "task_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Version"
        },
        "eval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        }
      },
      "required": [
        "framework"
      ],
      "title": "SourceEval",
      "type": "object"
    },
    "Span": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "positions": {
          "items": {
            "type": "integer"
          },
          "title": "Positions",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "Span",
      "type": "object"
    },
    "Text": {
      "description": "A named text segment on a :class:`Sample`.\n\nA sample's ``texts`` list carries one entry per source segment \u2014 for\nchat inputs that's one per message (including the system prompt); for\nplain-text inputs it's one per input string. The default naming scheme\nis role-based for chat (``\"system_0\"``, ``\"user_0\"``, ``\"assistant_0\"``,\n``\"user_1\"``, \u2026) and index-based for plain text (``\"text_0\"``,\n``\"text_1\"``, \u2026).\n\n``start`` and ``end`` are half-open token offsets covering the tokens\nthat render this text in the chat-template output (``[start, end)``):\nfor chat messages this captures the content plus any chat-template\ndelimiters assigned to that message; for plain text it covers the\nwhole token stream. They are ``None`` when the converter cannot map\nthe text to a token range (e.g. lossy decode round-trip).\n\n``metadata`` is a free-form dict for caller-supplied context (e.g.\nturn index, tool-call payload).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Text",
      "type": "object"
    },
    "TokenAnnotation": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ranges": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Ranges",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "TokenAnnotation",
      "type": "object"
    },
    "TokenOrSeqRef": {
      "additionalProperties": true,
      "description": "A token entry \u2014 either a vocabulary token or a reference to a Sequence.\n\nA vocabulary token has an integer ``id`` (the model's vocab id) and a\n``token`` string (the decoded piece). A sequence reference has\n``id is None`` and uses the ``token`` field to carry the target\n:class:`Sequence` id (a string). The presence / absence of ``id`` is\nthe discriminator \u2014 there is no separate ``sequence_id`` field.\n\nTokens accept arbitrary extra fields via ``model_config[\"extra\"] =\n\"allow\"``. Use the :meth:`set_extra` / :meth:`get_extra` helpers (not\ndirect attribute assignment) so values stay in sync between\n``__dict__`` and ``model_extra``.",
      "properties": {
        "token": {
          "title": "Token",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "token"
      ],
      "title": "TokenOrSeqRef",
      "type": "object"
    },
    "TokenExtras": {
      "description": "Conventional extra fields recognized by inif tooling.\n\nTokens accept arbitrary extras (``model_config[\"extra\"] = \"allow\"``); this\nmodel documents the well-known names so external validators, viewers, and\nconverters know what to expect. Not used at runtime \u2014 it only contributes\nto the JSON schema as a ``$defs`` entry.\n\nRepeated token labels such as chat roles, ``\"generated\"``, and\n``\"reasoning\"`` are stored in :class:`TokenAnnotation` ranges on\n:class:`Sample`, not repeated on every token.",
      "properties": {
        "logprob": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-token log-probability from the model",
          "title": "Logprob"
        },
        "logit_lens": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-layer logit-lens output keyed by layer name",
          "title": "Logit Lens"
        }
      },
      "title": "TokenExtras",
      "type": "object"
    }
  },
  "properties": {
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "sequences": {
      "items": {
        "$ref": "#/$defs/Sequence"
      },
      "title": "Sequences",
      "type": "array"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/Sample"
      },
      "title": "Samples",
      "type": "array"
    }
  },
  "required": [
    "metadata"
  ],
  "title": "InifDocument",
  "type": "object"
}
