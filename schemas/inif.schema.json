    "TokenExtras": {
      "description": "Conventional extra fields recognized by inif tooling.\n\nTokens accept arbitrary extras (``model_config[\"extra\"] = \"allow\"``); this\nmodel documents the well-known names so external validators, viewers, and\nconverters know what to expect. Not used at runtime \u2014 it only contributes\nto the JSON schema as a ``$defs`` entry.\n\nConventional ``role`` values: ``\"system\"``, ``\"user\"``, ``\"assistant\"``,\n``\"template\"``.\n\nConventional tags include: ``\"generated\"`` (model-produced),\n``\"special\"`` (special tokenizer ids), ``\"number\"``, ``\"entity\"``.",
      "properties": {
        "tags": {
          "description": "User-assigned labels",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chat-template role: system | user | assistant | template",
          "title": "Role"
        },
        "logprob": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-token log-probability from the model",
          "title": "Logprob"
        },
        "logit_lens": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-layer logit-lens output keyed by layer name",
          "title": "Logit Lens"
        }
      },
      "title": "TokenExtras",
      "type": "object"
    }
